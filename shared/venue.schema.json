{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperbaric.app/schemas/koltuk/venue.schema.json",
  "title": "venue.json — Koltuğundan Gör ortak veri formatı",
  "description": "Sürüm 0.2. v0.1 dosyaları da bu şemayla doğrulanır (yeni alanların hepsi opsiyonel). Ayrıntı: venue-schema-v0.2.md",
  "type": "object",
  "required": ["schemaVersion", "venue", "sections"],
  "properties": {
    "schemaVersion": { "enum": ["0.1", "0.2"] },
    "venue": { "$ref": "#/$defs/venue" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "viewpoints": { "type": "array", "items": { "$ref": "#/$defs/viewpoint" } }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,

  "$defs": {
    "vec3": {
      "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3,
      "description": "[x, y, z] metre; Y yukarı, sağ el kuralı"
    },
    "quat": {
      "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
      "description": "Birim kuaterniyon [x, y, z, w] (three.js sırası)"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },

    "venue": {
      "type": "object",
      "required": ["id", "name", "type", "focus", "scene"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["arena", "stadium", "theatre", "concert-hall"] },
        "capacity": { "type": "integer", "minimum": 0 },
        "focus": { "$ref": "#/$defs/vec3" },
        "origin": {
          "enum": ["field-center", "stage-front-center"],
          "description": "v0.2. Orijin tanımı. Yoksa: arena/stadium → field-center, theatre/concert-hall → stage-front-center"
        },
        "scene": { "$ref": "#/$defs/scene" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotationY": { "type": "number", "description": "DERECE. +Y ekseni etrafında sağ el kuralı (yukarıdan bakınca saat yönü tersi; +90 → +X ekseni -Z'ye döner)" },
        "rotation": { "$ref": "#/$defs/quat", "description": "v0.2, opsiyonel. Varsa rotationY yok sayılır" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },

    "sceneFile": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "$ref": "#/$defs/sceneFormat" },
        "lod": { "type": "integer", "minimum": 0, "description": "0 = en ayrıntılı; büyük sayı = daha kaba (önce yüklenir)" },
        "region": { "type": "string", "description": "Bölge etiketi (ör. alt-kat, kuzey). Aynı LOD'da farklı bölgeler birlikte yüklenir" },
        "bytes": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0, "description": "Splat veya üçgen sayısı" }
      },
      "additionalProperties": false
    },

    "sceneFormat": { "enum": ["ply", "compressed-ply", "sog", "spz", "splat", "ksplat", "glb", "gltf"] },

    "scene": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["procedural", "splat", "mesh"] },
        "url": { "type": ["string", "null"] },
        "format": { "$ref": "#/$defs/sceneFormat" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sceneFile" } },
        "transform": { "$ref": "#/$defs/transform" },
        "params": { "type": "object", "description": "Yalnız kind=procedural iken; görüntüleyiciye özgü serbest parametreler" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "procedural" } } },
          "then": { "properties": { "url": { "type": "null" } } },
          "else": {
            "not": { "required": ["params"] },
            "anyOf": [
              { "required": ["url"], "properties": { "url": { "type": "string", "minLength": 1 } } },
              { "required": ["files"] }
            ]
          }
        }
      ]
    },

    "obstructed": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["severity"],
          "properties": {
            "severity": { "enum": ["partial", "severe"] },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },

    "seat": {
      "type": "object",
      "required": ["id", "eye"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "ticketCode": { "$ref": "#/$defs/nonEmptyString" },
        "eye": { "$ref": "#/$defs/vec3" },
        "lookAt": { "$ref": "#/$defs/vec3" },
        "obstructed": { "$ref": "#/$defs/obstructed" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "row": {
      "type": "object",
      "required": ["id", "seats"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "seats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/seat" } }
      },
      "additionalProperties": false
    },

    "section": {
      "type": "object",
      "required": ["id", "tier", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "type": "string" },
        "tier": { "enum": ["lower", "middle", "upper", "vip", "floor"] },
        "priceCategory": { "type": "string" },
        "focus": { "$ref": "#/$defs/vec3" },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "capture": {
      "type": "object",
      "required": ["file", "type"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["equirect-360", "perspective"] },
        "takenAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "viewpoint": {
      "type": "object",
      "required": ["id", "sectionId", "eye"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "sectionId": { "$ref": "#/$defs/nonEmptyString" },
        "row": { "type": "string", "description": "v0.2" },
        "seat": { "type": "string", "description": "v0.2" },
        "lensHeight": { "type": "number", "minimum": 0, "maximum": 5, "description": "v0.2. Lens merkezinin basamak zemininden yüksekliği (m)" },
        "eye": { "$ref": "#/$defs/vec3" },
        "lookAt": { "$ref": "#/$defs/vec3" },
        "capture": { "oneOf": [ { "$ref": "#/$defs/capture" }, { "type": "null" } ] }
      },
      "additionalProperties": false
    }
  }
}
